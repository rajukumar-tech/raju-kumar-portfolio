# Copy this file to .env and fill in what you use. Never commit .env.

# AI Digital Twin (server-side only, never exposed to the browser).
# Get a key at https://console.anthropic.com. Without it, the chat widget
# still works in "offline mode" with quick answers from your portfolio data.
ANTHROPIC_API_KEY=

# Contact form (pick one; checked in this order). Without any of these,
# messages go through FormSubmit, which needs a one-time activation click.
# Web3Forms: free, instant. Get a key at https://web3forms.com
VITE_WEB3FORMS_KEY=

# Optional: EmailJS (https://www.emailjs.com) for the contact form. Without
# these, messages are delivered via FormSubmit to the email in constants.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
